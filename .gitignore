# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Package managers / caches
.uv/
uv.lock
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Data — keep the folder structure, ignore the contents.
# Commit small, shareable sample data by force-adding it (git add -f).
data/raw/*
data/processed/*
data/external/*
!data/**/.gitkeep

# Results — figures/tables are regenerated by the pipeline.
results/figures/*
results/tables/*
!results/**/.gitkeep

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.pdf
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Environment / secrets
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
